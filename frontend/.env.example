# Supabase project settings (Project Settings → API in the Supabase dashboard)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key, used for AI test generation
OPENAI_API_KEY=

# Both optional — only needed for scheduled/automatic package re-execution
# (see README's "Scheduled Execution" section). Without these set, the
# feature is fully built but inert: the toggle in the UI still saves, but
# api/internal/scheduled-runs 503s and nothing ever actually runs.
#
# Project Settings → API → service_role key (secret, NOT the anon key) in
# the Supabase dashboard. Bypasses RLS entirely — never expose this to the
# client, and it's only ever read inside api/internal/scheduled-runs.
SUPABASE_SERVICE_ROLE_KEY=

# A random secret you generate yourself (e.g. `openssl rand -hex 32`) — must
# match the value stored in Supabase Vault as 'cron_secret' (see
# migrations/20260907000100_schedule_package_reruns.sql). Authenticates the
# scheduled trigger; nothing else gates api/internal/scheduled-runs.
CRON_SECRET=
